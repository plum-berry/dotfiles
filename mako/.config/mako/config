# General behavior
sort=-time
layer=overlay
max-visible=5
default-timeout=6000
ignore-timeout=false

# Positioning
anchor=top-right
margin=10
padding=12
width=340
height=110

# Shape
border-radius=12
border-size=2
outer-margin=5

# Colors (dark, translucent — tweak hex/alpha to match your kitty theme)
background-color=#1e1e2e99
text-color=#cdd6f4
border-color=#89b4fa

# Typography
font=JetBrainsMono Nerd Font 11
markup=1
format=<b>%s</b>\n%b

# Icons
icons=1
max-icon-size=48
icon-path=/usr/share/icons/Papirus-Dark

# Progress bar (volume/brightness notifications)
progress-color=over #313244

# Grouping
group-by=app-name

# Per-urgency overrides
[urgency=low]
border-color=#6c7086
default-timeout=3000

[urgency=normal]
border-color=#89b4fa

[urgency=high]
border-color=#f38ba8
default-timeout=0
background-color=#1e1e2eee
